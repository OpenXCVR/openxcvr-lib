*.pdf
docs/stds/**/*.pdf
tests/fixtures/**/large/

# Local environment and editor/OS cruft
.env
.env.local
.DS_Store
.vscode/
.idea/
*.swp
*~

# Local agent worktrees
.worktrees/

# Local harness/session state
/.pi/
/.serena/

/.claude/*
!/.claude/agents/
