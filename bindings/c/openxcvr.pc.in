prefix=@CMAKE_INSTALL_PREFIX@
exec_prefix=${prefix}
libdir=${exec_prefix}/lib
includedir=${prefix}/include

Name: openxcvr-c
Description: C binding for openxcvr transceiver EEPROM decoding
Version: @PROJECT_VERSION@
Libs: -L${libdir} -lopenxcvr_c
Libs.private: @OPENXCVR_C_LIBS_PRIVATE@
Cflags: -I${includedir}
