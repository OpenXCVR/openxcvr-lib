<?xml version="1.0" encoding="utf-8"?>
<!-- Consumer check (review follow-up A5): the consumer restores against ONLY
     the packed nupkg from the local feed populated by run-consumer-check.sh
     (relative to this file). Everything else is cleared. -->
<configuration>
  <packageSources>
    <clear />
    <add key="openxcvr-local-feed" value="feed" />
  </packageSources>
</configuration>
