      "minItems": 8,
      "type": "array",
      "x-openxcvr-provenance": {
        "pdf_page": 319,
        "quote": "RedirectionCommitResult<n> encodes the result of the last (or current) host lane switching commit command on lane <n>",
        "section": "CMIS 5.4 § 8.33",
        "table": "Table 8-196"
      },
      "x-openxcvr-since": "5.4"
    },
    "redirection_of_media_lane": {
      "description": "Value is the media lane number j in {1..8} of the external media lane to which the internal media lane with lane number <lane> is to be redirected. A valid redirection is consistent with the granularity of active Data Paths or Network Paths including lane ordering within, and it is a permutation of the media lanes.",
      "items": {
        "maximum": 255,
        "minimum": 0,
        "type": "integer"
      },
      "maxItems": 8,
      "minItems": 8,
      "type": "array",
      "x-openxcvr-provenance": {
        "pdf_page": 318,
        "quote": "RedirectionOfLane<i> contains the media lane number j in {1, ..., 8} of the external media lane to which the internal media lane with lane number <i> is to be redirected.",
