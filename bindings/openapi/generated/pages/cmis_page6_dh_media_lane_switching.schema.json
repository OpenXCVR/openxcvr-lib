  "properties": {
    "commit_media_lane_redirection": {
      "type": "boolean",
      "x-openxcvr-provenance": {
        "pdf_page": 318,
        "quote": "CommitMediaLaneRedirection: 1b: Commit configuration in the RedirectionOfMediaLane register to HW. Traffic integrity on media lanes with unchanged redirection shall not be affected.",
        "section": "CMIS 5.4 § 8.33",
        "table": "Table 8-196"
      },
      "x-openxcvr-since": "5.4"
    },
    "enable_media_lane_redirection": {
      "description": "0b: disabled, commit command is without effect; 1b: enabled, commit command is effective. Initially, or after enabling for the first time, the RedirectStatusOfMediaLane register shows the trivial (unpermuted) media lane switch configuration; the commit command is not executed automatically on enable. When disabled, the current switch configuration remains in effect.",
      "type": "boolean",
      "x-openxcvr-provenance": {
        "pdf_page": 318,
        "quote": "EnableMediaLaneRedirection: 0b: disabled: commit command is without effect; 1b: enabled: commit command is effective",
        "section": "CMIS 5.4 § 8.33",
        "table": "Table 8-196"
      },
      "x-openxcvr-since": "5.4"
    },
    "max_redirection_commit_duration": {
      "description": "Encoded as defined in CMIS 5.4 Table 8-49 (State Duration Encoding).",
      "maximum": 15,
      "minimum": 0,
      "type": "integer",
      "x-openxcvr-provenance": {
        "pdf_page": 318,
        "quote": "MaxRedirectionCommitDuration: Maximum duration of the execution of a CommitMediaLaneRedirection command being in progress, encoded as defined in Table 8-49.",
        "section": "CMIS 5.4 § 8.33",
        "table": "Table 8-196"
      },
      "x-openxcvr-since": "5.4"
    },
    "redirect_status_of_media_lane": {
      "description": "Value is the media lane number m in {1..8} of the external media lane to which the internal media lane with lane number <lane> is redirected; default value is m = lane.",
      "items": {
        "maximum": 255,
        "minimum": 0,
        "type": "integer"
      },
      "maxItems": 8,
      "minItems": 8,
      "type": "array",
      "x-openxcvr-provenance": {
        "pdf_page": 319,
        "quote": "RedirectStatusOfLane<n> contains the media lane number <m> in {1, ..., 8} of the external media lane to which the internal media lane with lane number <n> is redirected. Default value: <m> = <n>",
        "section": "CMIS 5.4 § 8.33",
        "table": "Table 8-196"
      },
      "x-openxcvr-since": "5.4"
    },
    "redirection_commit_result": {
      "description": "Result of the last (or current) media lane switching commit command on media lane <lane>.",
      "items": {
        "$ref": "../enums/cmis_redirection_commit_result.schema.json"
